{
  "baselineCommit": "c93ab866d3c5d5e4edeb1693e4511077bd983261",
  "date": "2026-10-30",
  "sharedCommercialParagraphs": {
    "en": [
      "these components apply within the applicable managed monthly agreement and its stated scope the published benefits include the worker s salary government fees medical insurance return ticket and end of service benefits as applicable under that agreement they are not automatic benefits of every half day daily or weekly visit",
      "for the standard managed monthly offer the first service month is paid in advance and later payments follow the agreed monthly billing date there is no separate upfront recruitment setup fee and no security deposit separately contracted recruitment and visa only services have their own quotation and terms",
      "before service commencement inaya returns the unused monthly service payment after commencement the unused prepaid service period following effective cancellation is refunded on a clear pro rata basis the calculation identifies the prepaid amount service period effective cancellation date and unused period",
      "the managed monthly agreement includes review and administration of eligible replacement requests eligibility is assessed against the agreed duties applicable employment arrangement and relevant legal obligations matching coordination and follow up follow the agreed service plan",
      "inaya coordinates follow up according to the agreed service plan the written plan records the contact person review schedule and how household feedback or replacement concerns will be handled"
    ],
    "ar": [
      "تسري هذه العناصر ضمن اتفاق الخدمة الشهرية المدارة المنطبق ونطاقه المحدد وتشمل المزايا المنشورة راتب العاملة والرسوم الحكومية والتأمين الطبي وتذكرة العودة ومكافأة نهاية الخدمة بحسب ما ينطبق في ذلك الاتفاق ولا تعد مزايا تلقائية لكل زيارة بنصف يوم أو يومية أو أسبوعية",
      "في العرض الشهري القياسي المدار يسدد الشهر الأول مقدما ثم تتبع الدفعات اللاحقة تاريخ الفوترة الشهري المتفق عليه لا توجد رسوم استقدام أو تجهيز منفصلة مقدما ولا تأمين نقدي وتكون لخدمات الاستقدام أو التأشيرة المتعاقد عليها منفصلة عروضها وشروطها الخاصة",
      "قبل بدء الخدمة تعيد عناية دفعة الخدمة الشهرية غير المستخدمة وبعد البدء ترد قيمة الفترة المدفوعة مقدما وغير المستخدمة بعد سريان الإلغاء على أساس تناسبي واضح يبين الحساب المبلغ المدفوع وفترة الخدمة وتاريخ سريان الإلغاء والفترة غير المستخدمة",
      "يشمل اتفاق الخدمة الشهرية المدارة مراجعة طلبات الاستبدال المؤهلة وإدارة إجراءاتها تقيم الأهلية وفق المهام المتفق عليها وترتيب التوظيف المنطبق والالتزامات القانونية ذات الصلة يتبع تنسيق المطابقة والمتابعة خطة الخدمة المتفق عليها",
      "تنسق عناية المتابعة وفق خطة الخدمة المتفق عليها تسجل الخطة المكتوبة مسؤول التواصل وجدول المراجعة وطريقة التعامل مع ملاحظات الأسرة أو طلبات الاستبدال"
    ]
  },
